# MyWhatsapp - bundled local configuration for the Windows (per-user) install.
#
# The launcher also passes these as real process env vars, which win over this file
# (dotenv never overrides an already-set variable). They are repeated here so the
# installed tree documents itself and stays correct if node is started by hand.
#
# Paths are relative to the app\ directory, which is the launcher's working directory.

# Left in development on purpose. unset/development is the documented local-run mode and is
# what keeps the production secret guard (API_MASTER_KEY / ALLOW_DEV_API_KEY) from refusing
# to boot a single-user desktop install. Set to production only behind a real secret setup.
NODE_ENV=development

PORT=2785
SERVE_DASHBOARD=true

# Single-file local database: no Docker, no Redis, no Postgres.
DATABASE_TYPE=sqlite

LOG_LEVEL=info

# Bundled plugins and whatsapp-web.js auth data both live under app\data\.
PLUGINS_DIR=./data/plugins

# The launcher also sets PUPPETEER_CACHE_DIR to a per-user writable path so that
# whatsapp-web.js can download its Chromium build on first use.